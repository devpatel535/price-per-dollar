{
  "name": "price-per-dollar",
  "version": "1.0.0",
  "description": "Chrome extension that normalises every price on a shopping page to a true cost-per-unit and shows exactly what one dollar buys.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "icons": "node tools/generate-icons.mjs",
    "build": "node tools/build.mjs",
    "build:watch": "node tools/build.mjs --watch",
    "package": "node tools/build.mjs && node tools/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node tools/build.mjs && node tools/e2e.mjs",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
